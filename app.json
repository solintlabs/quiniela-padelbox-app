{
  "expo": {
    "name": "QuinielaBOX",
    "slug": "quiniela-padelbox-app",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "quinielapadelbox",
      "com.googleusercontent.apps.4316983371-8hc1ck2hl08k3hgpoesk20663ej6oal3"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "primaryColor": "#B6FF3C",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A",
      "imageResizeMode": "contain"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.solint.quinielapadelbox",
      "buildNumber": "23",
      "usesAppleSignIn": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "package": "cloud.solint.quinielapadelbox",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#B6FF3C"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://quiniela.solint.cloud",
      "googleIosClientId": "4316983371-8hc1ck2hl08k3hgpoesk20663ej6oal3.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "eeb72121-4a6d-4398-a009-c07c9dd43dd9"
      }
    },
    "owner": "solintlabs",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eeb72121-4a6d-4398-a009-c07c9dd43dd9"
    }
  }
}
